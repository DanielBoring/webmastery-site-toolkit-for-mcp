# Auto detect text files and perform LF normalization
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.php text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
tests/e2e/bounded-list-recovery.py text eol=lf
tests/unit/test_bounded_recovery.py text eol=lf
scripts/untrusted-query.py text eol=lf
tests/unit/test_untrusted_query.py text eol=lf
tests/fixtures/php80-floor/Dockerfile text eol=lf
tests/unit/fixtures/untrusted-docker text eol=lf
tests/unit/fixtures/untrusted-host-process text eol=lf

# Preserve reviewed source-bound bytes instead of normalizing their line endings.
phpcs.xml.dist -text whitespace=cr-at-eol
phpstan-baseline.neon -text whitespace=cr-at-eol
phpstan.neon.dist -text whitespace=cr-at-eol
phpunit.xml.dist -text whitespace=cr-at-eol
