# Auto detect text files and perform LF normalization
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.php text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf

# Preserve existing reviewed source and fixture bytes.
phpcs.xml.dist -text whitespace=cr-at-eol
phpstan-baseline.neon -text whitespace=cr-at-eol
phpstan.neon.dist -text whitespace=cr-at-eol
phpunit.xml.dist -text whitespace=cr-at-eol
scripts/qa-local.ps1 -text whitespace=cr-at-eol
tests/unit/ArraySyntaxTest.php -text whitespace=cr-at-eol
