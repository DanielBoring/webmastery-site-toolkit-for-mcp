# Auto detect text files and perform LF normalization
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.php text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
tests/e2e/bounded-list-recovery.py text eol=lf
tests/unit/test_bounded_recovery.py text eol=lf
