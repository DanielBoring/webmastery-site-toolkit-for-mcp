><mxCell id="c32" value="&lt;b&gt;07 - Compatibility QA&lt;/b&gt;&lt;br&gt;8 version lanes + current&lt;br&gt;Plugin Check, Mon 09:17" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#6d28d9;fontFamily=Helvetica;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="490" y="425" width="210" height="70" as="geometry"/></mxCell><mxCell id="c33" value="If newer versions pass:&lt;br&gt;baseline PR through PR&lt;br&gt;checks, never auto-merged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;dashed=1;fontFamily=Helvetica;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="730" y="425" width="200" height="70" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;11 - Ruleset Audit&lt;/b&gt;&lt;br&gt;rulesets + release env&lt;br&gt;match repo files, Mon 09:47" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#6d28d9;fontFamily=Helvetica;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="990" y="425" width="210" height="70" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeColor=#374151;fontSize=11;fontFamily=Helvetica;fontColor=#1f2937;entryX=0;entryY=0.5;exitX=1;exitY=0.5;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="Push tag&lt;br&gt;vX.Y.Z" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#374151;fontFamily=Helvetica;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="120" height="60" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;08 - Release / validate&lt;/b&gt;&lt;br&gt;tag on main; 01, 02, 03-04,&lt;br&gt;05 and 06 passed on that&lt;br&gt;exact main SHA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontFamily=Helvetica;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="210" y="585" width="230" hei