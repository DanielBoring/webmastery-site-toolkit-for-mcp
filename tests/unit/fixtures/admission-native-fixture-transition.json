          "start": 106,
          "before": [],
          "after": [
            "",
            "\tpublic function test_real_php_to_python_query_handoff_retains_original_streams_and_receipt(): void {",
            "\t\t$directory = realpath( sys_get_temp_dir() ) . '/wstm108-query-handoff-' . bin2hex( random_bytes( 16 ) );",
            "\t\tif ( PHP_VERSION_ID < 80100 || 'Linux' !== PHP_OS_FAMILY ) {",
            "\t\t\ttry {",
            "\t\t\t\tnew Wstm108_HostController( $directory, array(), array() );",
            "\t\t\t\tself::fail( 'An unsupported host must refuse before query reservation.' );",
            "\t\t\t} catch ( RuntimeException $error ) {",
            "\t\t\t\tself::assertStringContainsString( 'host-requires-native-linux-php81-posix-and-builtin-fsync', $error->getMessage() );",
            "\t\t\t\tself::assertDirectoryDoesNotExist( $directory );",
            "\t\t\t}",
            "\t\t\treturn;",
            "\t\t}",
            "\t\tWstm108_Export::require_host();",
            "\t\t$root = dirname( __DIR__, 2 );",
            "\t\t$mask = umask( 0077 );",
            "\t\t$passed = false;",
            "\t\ttry {",
            "\t\t\tself::assertTrue( mkdir( $directory, 0700 ) );",
            "\t\t\t$php = realpath( PHP_BINARY );",
            "\t\t\t$command = array( $php, $root . '/scripts/qa-runtime.php', 'frame' );",
            "\t\t\t$controller = new Wstm108_HostController( $directory, Wstm108_Files::directory( $directory ),",
            "\t\t\t\tarray( 'PATH' => '/usr/bin:/bin', 'WSTM108_HOST_PHP' => $php, 'COMPOSE_PROJECT_NAME' => 'wstm108-query-handoff' ) );",
            "\t\t\t$result = $controller->query( $command, 'handoff' );",
            "\t\t\tself::assertSame( array( 'profile' => '', 'compose_argv' => array( 'docker', 'compose', '--project-name', 'wstm108-query-handoff' ),",
            "\t\t\t\t'environment' => array(), 'config' => null ), $result );",
            "\t\t\t$captures = glob( $directory . '/handoff-query-*-supervised' );",
            "\t\t\tself::assertCount( 1, $captures );",
            "\t\t\t$captured = $captures[0];",
            "\t\t\t$receipt = json_decode( file_get_contents( $captured . '/receipt.json' ), true, 512, JSON_THROW_ON_ERROR );",
            "\t\t\tself::assertSame( $command, $receipt['argv'] );",
            "\t\t\tself::assertSame( 0, $receipt['exit_code'] );",
            "\t\t\tself::assertTrue( $receipt['root_exit_observed'] );",
            "\t\t\tforeach ( array( 'stdout', 'stderr' ) as $stream ) {",
            "\t\t\t\t$original = Wstm108_Files::file( $captured . '/' . $stream . '.log' );",
            "\t\t\t\tself::assertTrue( $receipt[ $stream . '_eof' ] );",
            "\t\t\t\tself::assertSame( $original['sha256'], $receipt[ $stream . '_sha256' ] );",
            "\t\t\t\tself::assertSame( strlen( $original['bytes'] ), $receipt[ $stream . '_bytes' ] );",
            "\t\t\t\tself::assertSame( 0100600, $original['identity']['mode'] );",
            "\t\t\t\tself::assertSame( posix_geteuid(), $original['identity']['uid'] );",
            "\t\t\t\tself::assertSame( '', file_get_contents( $captured . '/' . $stream . '.overflow.bin' ) );",
            "\t\t\t}",
            "\t\t\tself::assertSame( '', file_get_contents( $captured . '/stderr.log' ) );",
            "\t\t\tself::assertSame( $result, json_decode( file_get_contents( $captured . '/stdout.log' ), true, 512, JSON_THROW_ON_ERROR ) );",
            "\t\t\tself::assertFalse( $receipt['truncated'] );",
            "\t\t\tself::assertNull( $receipt['failure'] );",
            "\t\t\tself::assertSame( array(), $receipt['secondary_errors'] );",
            "\t\t\t$passed = true;",
            "\t\t} finally {",
            "\t\t\tumask( $mask );",
            "\t\t\tif ( $passed ) {",
            "\t\t\t\t$children = new RecursiveIteratorIterator( new RecursiveDirectoryIterator( $directory, FilesystemIterator::SKIP_DOTS ), RecursiveIteratorIterator::CHILD_FIRST );",
            "\t\t\t\tforeach ( $children as $child ) { self::assertTrue( $child->isDir() ? rmdir( $child->getPathname() ) : unlink( $child->getPathname() ) ); }",
            "\t\t\t\tself::assertTrue( rmdir( $directory ) );",
            "\t\t\t}",
            "\t\t}",
            "\t}"
          ]
        }
      ]
    },
