            "\t\t\tforeach ( $property->getValue() as $site ) { self::assertSame( 1, $site['count'] ); }",
            "\t\t\tself::assertSame( $original, file_get_contents( $path ), 'Production query source stays unchanged.' );",
            "\t\t} finally {",
            "\t\t\t$property->setValue( null, $old_sites );",
            "\t\t}"
