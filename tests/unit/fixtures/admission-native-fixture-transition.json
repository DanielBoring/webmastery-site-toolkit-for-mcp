            "",
            "\t/** @dataProvider endings */",
            "\tpublic function test_owned_installer_graph_retains_query_and_real_supervisor_without_admitting_host( string $ending ): void {",
            "\t\t$origin = realpath( sys_get_temp_dir() ) . '/wstm108-installer-graph-' . bin2hex( random_bytes( 16 ) );",
            "\t\t$copy = $origin . '/build/work with spaces/checkout';",
            "\t\tself::assertDirectoryDoesNotExist( $origin );",
            "\t\ttry {",
            "\t\t\t$before = self::stage_installer_graph( $origin, $copy, $ending );",
