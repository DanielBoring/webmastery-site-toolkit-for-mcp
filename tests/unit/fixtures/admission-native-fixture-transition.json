            "\tprivate static function stage_installer_graph( string $origin, string $copy, string $ending ): array {",
            "\t\t$before = array();",
            "\t\tforeach ( array_merge( self::INSTALLER_CORE, self::INSTALLER_EDITED, self::INSTALLER_SUPPORT ) as $path ) {",
