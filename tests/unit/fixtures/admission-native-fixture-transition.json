            "\t\t\tself::assertStringContainsString( 'ROOT / \"tests/e2e/bounded-list-controller.py\"', $before['scripts/untrusted-query.py'] );",
            "\t\t\tforeach ( $before as $path => $bytes ) {",
            "\t\t\t\tself::assertSame( $bytes, file_get_contents( $origin . '/' . $path ) );",
            "\t\t\t\tself::assertSame( $bytes, file_get_contents( $copy . '/' . $path ) );",
            "\t\t\t}",
            "\t\t\tself::assertFileDoesNotExist( $origin . '/build/work with spaces/synthetic-host-boundaries.private.json' );",
            "\t\t} finally {",
            "\t\t\tif ( is_dir( $origin ) ) {",
            "\t\t\t\t$children = new RecursiveIteratorIterator( new RecursiveDirectoryIterator( $origin, FilesystemIterator::SKIP_DOTS ), RecursiveIteratorIterator::CHILD_FIRST );",
            "\t\t\t\tforeach ( $children as $child ) {",
            "\t\t\t\t\tself::assertTrue( $child->isDir() ? rmdir( $child->getPathname() ) : unlink( $child->getPathname() ) );",
            "\t\t\t\t}",
