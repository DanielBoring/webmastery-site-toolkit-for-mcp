            "\t\t$root = \"/synthetic/quote' and \\\\slash/\\u{2603}/\\u{1f680}\";",
            "\t\t$docker = 'Path(' . json_encode( $root . '/bin/docker', JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE ) . ')';",
            "\t\t$owner = 'and identity.st_uid == (os.getuid() if binary == ' . $docker . ' else 0)';",
            "\t\t$property = new ReflectionProperty( Wstm108_HostBoundaryFixture::class, 'substitutions' );",
            "\t\t$property->setAccessible( true );",
            "\t\t$old_sites = $property->getValue();",
            "\t\t$property->setValue( null, array() );",
            "\t\ttry {",
            "\t\t\t$copy = self::fixture( 'query_adapter', array( $source, $root ) );",
            "\t\t\tself::assertSame( 1, substr_count( $copy, $owner ), 'Only the explicitly copied Docker executable uses the fixture owner.' );",
            "\t\t\tself::assertStringNotContainsString( '\\/', $docker, 'JSON slash escaping is not a Python path escape.' );",
            "\t\t\tself::assertStringNotContainsString( 'and identity.st_uid == os.getuid()', $copy );",
            "\t\t\tself::assertSame( $source, str_replace( array( $owner, $docker ),",
            "\t\t\t\tarray( 'and identity.st_uid == 0', 'Path(\"/usr/bin/docker\")' ), $copy ) );",
