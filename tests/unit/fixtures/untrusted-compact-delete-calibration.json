            "after_sha256": "a32d648d11f6aec983074b67e03dd4cf1e5a9df6c3cef2e062ff268f5fd606e9",
            "observed_response": {
                "success": true,
                "data": {
                    "id": 65,
                    "status": "trash"
                }
            },
            "before": {
                "ability": "webmastery-site-toolkit-for-mcp/delete-post",
                "label": "wstm120 contributor trashes own draft",
                "role": "contributor",
                "input": {
                    "post_id": "__wstm120_contributor_delete_id__"
                },
                "expect": "success",
                "assert_permission": true,
                "assert_values": {
                    "data.id": "__wstm120_contributor_delete_id__",
                    "data.status": "trash",
                    "data.untrusted_fields": [
                        "title",
                        "content",
                        "excerpt",
                        "slug",
                        "url",
                        "author_name"
                    ]
                },
                "assert_stored_post": {
                    "post_id": "__wstm120_contributor_delete_id__",
                    "fields": {
                        "post_status": "trash",
                        "post_content": "WSTM120 delete content."
                    }
                },
                "assert_post_meta": [
                    {
                        "post_id": "__wstm120_contributor_delete_id__",
                        "meta_key": "_wp_trash_meta_status",
                        "value": "draft"
                    }
                ]
            },
            "after": {
                "ability": "webmastery-site-toolkit-for-mcp/delete-post",
                "label": "wstm120 contributor trashes own draft",
                "role": "contributor",
                "input": {
                    "post_id": "__wstm120_contributor_delete_id__"
                },
                "expect": "success",
                "assert_permission": true,
                "assert_values": {
                    "data.id": "__wstm120_contributor_delete_id__",
                    "data.status": "trash",
                    "data": {
                        "id": "__wstm120_contributor_delete_id__",
                        "status": "trash"
                    }
                },
                "assert_stored_post": {
                    "post_id": "__wstm120_contributor_delete_id__",
                    "fields": {
                        "post_status": "trash",
                        "post_content": "WSTM120 delete content."
                    }
