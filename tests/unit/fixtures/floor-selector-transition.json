      "current_blob": "2a504d71f5355a11a1837d96494e4f1a2b576cbd",
      "hunks": [
        {
          "start": 3,
          "before": [],
          "after": [
            "\tif [[ -n \"${WSTM_QA_RUNTIME_PROFILE:-}${WSTM_PHP80_CONFIG+x}${WSTM_PHP80_CONFIG_SHA256+x}\" ]]; then",
            "\t\tlocal selection argument command=\"${1:-}\" option_value=0",
            "\t\tlocal WSTM_QA_COMPOSE_ARGV=()",
            "\t\tlocal arguments=( \"$@\" )",
            "\t\tif [[ -z \"$command\" || \"$command\" == -* ]]; then",
            "\t\t\techo \"Floor Compose requires a subcommand, not caller-selected global options.\" >&2",
            "\t\t\treturn 1",
            "\t\tfi",
            "\t\tfor argument in \"${arguments[@]:1}\"; do",
            "\t\t\tif [[ \"$option_value\" == 1 ]]; then option_value=0; continue; fi",
            "\t\t\tcase \"$argument\" in",
            "\t\t\t\t-f*|-p*|--file*|--project-name*|--project-directory*|--env-file*|--profile*)",
            "\t\t\t\t\techo \"Floor Compose selector cannot be overridden by call arguments.\" >&2",
            "\t\t\t\t\treturn 1 ;;",
            "\t\t\tesac",
            "\t\t\tif [[ \"$argument\" == -[^-]* && \"$argument\" == *[fp]* ]]; then",
            "\t\t\t\techo \"Floor Compose rejects combined caller-selected file/project flags.\" >&2",
            "\t\t\t\treturn 1",
            "\t\t\tfi",
            "\t\t\tif [[ \"$command\" == exec ]]; then",
            "\t\t\t\tcase \"$argument\" in",
            "\t\t\t\t\t-e|--env|-u|--user|-w|--workdir|--index) option_value=1 ;;",
            "\t\t\t\t\t-T|-d|-i|-t|--no-TTY|--detach|--interactive|--privileged|--env=*|--user=*|--workdir=*|--index=*) ;;",
            "\t\t\t\t\t-*) echo \"Unrecognized floor exec option; refusing ambiguous selection.\" >&2; return 1 ;;",
            "\t\t\t\t\t*) break ;; # Service begins exec's untouched child argv.",
            "\t\t\t\tesac",
            "\t\t\tfi",
            "\t\tdone",
            "\t\tselection=\"$(\"${WSTM108_HOST_PHP-php}\" \"$(dirname \"${BASH_SOURCE[0]}\")/qa-runtime.php\" shell)\" || return $?",
            "\t\t# Only the closed, pinned source helper emits shell-quoted exports/argv.",
            "\t\teval \"$selection\"",
            "\t\t\"${WSTM_QA_COMPOSE_ARGV[@]}\" \"$@\"",
            "\t\treturn $?",
            "\tfi"
          ]
        }
      ]
    },
